{
  "expo": {
    "name": "Islam App",
    "slug": "islam-app",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "islamapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.islamapp.personal",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0E4D40",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.islamapp.personal"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E4D40",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0E4D40",
          "sounds": [
            "./assets/sounds/azan_a.ogg",
            "./assets/sounds/azan_short.ogg",
            "./assets/sounds/azan_b.ogg",
            "./assets/sounds/azan_b_short.ogg",
            "./assets/sounds/azan_medina.ogg",
            "./assets/sounds/azan_medina_short.ogg",
            "./assets/sounds/azan_rast.ogg",
            "./assets/sounds/azan_rast_short.ogg",
            "./assets/sounds/azan_aaqib.ogg",
            "./assets/sounds/azan_aaqib_short.ogg",
            "./assets/sounds/azan_fajr.ogg"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Der Standort wird für Gebetszeiten und die Qibla-Richtung verwendet."
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true,
          "microphonePermission": "Das Mikrofon wird nur für „Rezitation prüfen“ verwendet. Die Erkennung läuft auf dem Gerät."
        }
      ],
      "expo-background-task",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.** { *; }\n-keep class com.rnwhisper.** { *; }"
          }
        }
      ],
      "./plugins/with-abi-splits.js"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
